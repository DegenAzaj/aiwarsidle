# Unity (AI Wars Idle)
#
# Keep:
# - Assets/
# - Packages/manifest.json
# - Packages/packages-lock.json
# - ProjectSettings/
#

# OS / Editor noise
.DS_Store
Thumbs.db

# IDEs
.vs/
.vscode/
.idea/
*.user
*.userprefs
*.suo
*.tmp
*.log

# DCC / art tool backups
*.blend1
*.blend2
*.psd~
*.kra~
*.xcf~
*.aseprite~

# Unity generated folders
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Ll]ogs/
[Uu]serSettings/
[Mm]emoryCaptures/

# Builds
[Bb]uild/
[Bb]uilds/

# Unity auto-generated solution/project files
*.csproj
*.unityproj
*.sln
*.slnx
*.mdb
*.opendb
*.VC.db

# Crash/diagnostics
sysinfo.txt

# External Dependency Manager (EDM4U) / Firebase resolver outputs (regenerable)
**/[Aa]ssets/[Gg]eneratedLocalRepo/
**/[Aa]ssets/[Gg]eneratedLocalRepo.meta
**/[Pp]roject[Ss]ettings/AndroidResolverDependencies.xml
**/[Pp]roject[Ss]ettings/GvhProjectSettings.xml

# Android / iOS signing & local config (never commit)
*.keystore
*.jks
*.p12
*.mobileprovision
**/local.properties

# Gradle caches (if any exported projects are created)
**/.gradle/

# Addressables / StreamingAssets caches (optional, safe to ignore)
**/[Aa]ssets/[Aa]ddressableAssetsData/*/*.bin*
**/[Aa]ssets/[Aa]ddressableAssetsData/*/*.json
